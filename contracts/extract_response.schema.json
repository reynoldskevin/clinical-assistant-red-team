    "unsupported_fields": { "type": "array", "items": { "type": "string" } },
    "fact": { "type": "object" },
    "correlation_id": { "type": "string" },
    "identity_check": { "type": ["object", "null"] }
  },
  "required": ["ok", "doc_type", "confidence", "low_confidence", "unsupported_fields", "fact", "correlation_id"]
}
