{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AskRequest",
  "description": "POST /ask (and /ask/stream) request body. Mirrors contracts.AskRequest (extra=forbid).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pid": { "type": "integer" },
    "question": { "type": "string" },
    "conversation_id": { "type": ["string", "null"] }
  },
  "required": ["pid", "question"]
}
